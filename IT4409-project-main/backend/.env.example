NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/firebite
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
CLIENT_URL=http://localhost:5173

# reCAPTCHA
RECAPTCHA_SKIP_VERIFY=true
RECAPTCHA_SECRET=
RECAPTCHA_MIN_SCORE=0.5

# Google OAuth
GOOGLE_CLIENT_ID=

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=FireBite <no-reply@firebite.local>

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis cache
REDIS_URL=

# ZaloPay sandbox/merchant config
ZALOPAY_APP_ID=
ZALOPAY_KEY1=
ZALOPAY_KEY2=
ZALOPAY_ENDPOINT=
ZALOPAY_QUERY_ENDPOINT=
